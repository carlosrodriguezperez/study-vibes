# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# DeepSeek V4.1 Flash via OpenRouter — script, quiz, and image transcription (text)
OPENROUTER_API_KEY=

# Gemini TTS — audio only. DeepSeek has no speech synthesis.
GEMINI_API_KEY=

# Optional overrides
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# TTS_MODEL=gemini-3.8-flash-tts
# TTS_VOICE=Kore
